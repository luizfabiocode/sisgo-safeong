# ===================================================
# SiSGO (SafeONG) - Variáveis de Ambiente de Exemplo
# ===================================================

# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados SQLite (Prisma ORM)
DATABASE_URL="file:./dev.db"

# Autenticação e Criptografia
JWT_SECRET="sisgo_secret_jwt_key_segura_para_autenticacao_safeong_2025"
JWT_EXPIRES_IN="1d"

# Configuração de Cookie HTTP-Only
COOKIE_SECRET="sisgo_cookie_secret_safeong_signing_key"

# URLs da Aplicação
APP_URL="http://localhost:3000"

# Opcional: Chave Gemini para análises
GEMINI_API_KEY=""
